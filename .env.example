# Brevo API credentials and sender settings
# Copy this file to .env and replace the placeholder values.
# Do NOT commit the real .env file.

BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=Activity 1 Notification App

# BREVO_RECIPIENT_EMAIL is intentionally not stored here.
# The recipient is entered through the application's Email Recipient field.
